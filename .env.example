# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Supabase — project URL and publishable (client-safe) key.
# Settings -> API Keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://lwuycdhoilckrxymjokq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase secret (service role) key. Bypasses RLS — server-only, never
# NEXT_PUBLIC_. Used by the TMDB sync and the embedding job.
SUPABASE_SECRET_KEY=sb_secret_...

# TMDB v4 read access token (not the v3 api_key).
# https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# OpenAI — embeddings (text-embedding-3-small) and the chat agent.
OPENAI_API_KEY=sk-proj-...

# Optional: override the chat model (defaults to gpt-5.5).
# CHAT_MODEL=gpt-5.5

# Pinecone. The index name is optional and defaults to cinema-brain-movies;
# `npm run pinecone:setup` creates the index with the matching dimension.
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=cinema-brain-movies
